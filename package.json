{
  "name": "pediatric-clinic",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "agent:hooks": "fallow hooks install --target agent",
    "agent:wire": "fallow agent install",
    "arch": "fallow architecture",
    "arch:guard": "fallow guard",
    "auth:gen": "bunx auth@latest generate ",
    "baseline:dead-code": "fallow dead-code --save-baseline .fallow/dead-code.baseline.json",
    "baseline:dupes": "fallow dupes    --save-baseline .fallow/dupes.baseline.json",
    "baseline:health": "fallow health   --save-baseline .fallow/health.baseline.json",
    "build": "vite build",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "check-types": "vite build && tsc --noEmit",
    "check:all": "fallow -f json --lean --explain-skipped",
    "check:dupes": "fallow dupes --baseline .fallow/dupes.baseline.json --fail-on-regression --fail-on-stale-baseline",
    "check:fix": "bun run fix",
    "check:full": "fallow dead-code --baseline .fallow/dead-code.baseline.json --fail-on-regression --fail-on-stale-baseline -f sarif --ci",
    "check:health": "fallow health --baseline .fallow/health.baseline.json --baseline-mode identity --fail-on-regression --fail-on-stale-baseline",
    "check:pr": "fallow audit --base origin/main -f github-annotations --fail-on-issues",
    "check:symbol": "fallow dead-code --type-aware --symbol-impact",
    "check:types": "fallow dead-code --type-aware --lean -f json",
    "config:show": "fallow config",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:reset": "bun src/db/reset.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:admin": "bun src/db/seed/seed-admin.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "vite dev --port 3000",
    "dev:stop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-stop.ts",
    "dev:url": "node --import tsx scripts/worktree-port.ts --print",
    "doctor": "fallow doctor",
    "dupes:report": "fallow dupes -f markdown --explain",
    "fcheck": "fallow dead-code --lean -f json --explain-skipped",
    "fix": "ultracite fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-routes": "tsr generate && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prebuild": "lsof -ti:3000 | xargs -r kill -9 || true",
    "predev": "lsof -ti:3000 | xargs -r kill -9 || true",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "start:prod": "serve -s dist -l ${PORT:-3000}",
    "test": "bun test run --project unit",
    "test:ci": "bun test run --coverage",
    "test:coverage": "bun test run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "bun test --ui",
    "test:unit": "bun test run",
    "test:watch": "bun test --watch --project unit",
    "type": "bun check --no-fmt --no-lint",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty",
    "ui": "bunx shadcn@canary add -o -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@faker-js/faker": "^10.6.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/ai": "1.8.0",
    "@tanstack/ai-anthropic": "1.2.1",
    "@tanstack/ai-client": "1.2.1",
    "@tanstack/ai-gemini": "1.3.0",
    "@tanstack/ai-ollama": "1.1.1",
    "@tanstack/ai-openai": "1.2.0",
    "@tanstack/ai-react": "1.1.1",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-store": "0.11.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/store": "0.11.3",
    "better-auth": "^1.7.28",
    "bullmq": "^6.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "drizzle-orm": "^1.0.0-rc.6",
    "drizzle-seed": "^1.0.0-rc.5",
    "highlight.js": "^11.12.0",
    "ioredis": "^6.1.0",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.261103-rc",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.8.1",
    "superjson": "^2.2.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.3.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/oxlint-config": "^0.2.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "^1.4.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^1.0.0-rc.6",
    "eslint-plugin-drizzle": "^0.2.3",
    "fallow": "^3.48.0",
    "lefthook": "^2.2.3",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tsgolint": "^7.0.2008",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tsc": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@google/genai",
      "protobufjs"
    ]
  },
  "trustedDependencies": [
    "@google/genai",
    "esbuild",
    "lefthook",
    "msgpackr-extract",
    "protobufjs"
  ]
}
